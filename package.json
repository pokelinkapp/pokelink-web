{
    "name": "pokelink_themes_v2",
    "version": "2.0.0",
    "description": "",
    "license": "MIT",
    "repository": "https://github.com/pokelinkapp/pokelink-web",
    "type": "module",
    "engines": {
        "node": "24"
    },
    "scripts": {
        "prep": "yarn install",
        "build:themes": "yarn build:core && yarn build:themes:nodeps",
        "build:themes:nodeps": "yarn tsc -p ./themes/tsconfig.json",
        "build:badges": "yarn build:core && yarn build:badges:nodeps",
        "build:badges:nodeps": "yarn tsc -p ./badges/tsconfig.json",
        "build:graveyards": "yarn build:core && yarn build:badges:nodeps",
        "build:graveyards:nodeps": "yarn tsc -p ./graveyards/tsconfig.json",
        "build:core": "yarn tsc -p ./assets/tsconfig.json && yarn webpack --config webpack.config.js",
        "build:v3": "yarn prep && yarn buf generate && yarn build:core && yarn build:themes:nodeps && yarn build:badges:nodeps && yarn build:graveyards:nodeps",
        "build:v2": "cd v2 && yarn build",
        "build": "yarn build:v3 && yarn build:v2"
    },
    "dependencies": {
        "@bufbuild/buf": "^1.72.0",
        "@bufbuild/protobuf": "^2.14.1",
        "@bufbuild/protoc-gen-es": "^2.14.1",
        "@types/color-hash": "^2.0.0",
        "collect.js": "^4.36.1",
        "color-hash": "^2.0.2",
        "esbuild-loader": "^4.5.0",
        "handlebars": "^4.7.9",
        "typescript": "^7.0.2",
        "vue": "^3.5.42",
        "vue-tsc": "^3.3.11",
        "webpack": "^5.110.3",
        "webpack-cli": "^7.2.3"
    }
}
